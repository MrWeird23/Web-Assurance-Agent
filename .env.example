# Generate a unique random value; never commit the real token.
TRIAGE_WEBHOOK_TOKEN=replace-with-at-least-16-random-characters

# Exact public hostnames the agent is permitted to request.
TRIAGE_ALLOWED_HOSTS=example.com,www.example.com

# Leave empty for dry-run logging. Add only after company approval.
TRIAGE_DISCORD_WEBHOOK_URL=

TRIAGE_CONFIRMATION_ATTEMPTS=2
TRIAGE_CONFIRMATION_DELAY_SECONDS=5
TRIAGE_REQUEST_TIMEOUT_SECONDS=15
# Compose supplies these paths. Set them explicitly for a non-Compose runtime.
TRIAGE_SITE_MANIFEST_PATH=
TRIAGE_BROWSER_ARTIFACT_DIRECTORY=
# Enables comparison against separately stored human-approved baselines.
TRIAGE_VISUAL_BASELINE_DIRECTORY=
# Maximum simultaneous manual browser checks per service process (1-4).
TRIAGE_MANUAL_CHECK_CONCURRENCY=1
LOG_LEVEL=INFO
